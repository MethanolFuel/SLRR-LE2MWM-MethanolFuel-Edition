<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Slrr.App</RootNamespace>
    <AssemblyName>slrr-app</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Directory.Build.props pins every project to x64. An Apple Silicon (osx-arm64) or win-arm64 publish cannot load x64-marked
      assemblies, so a RID-specific publish of the app turns the platform target to AnyCPU; pass -p:PlatformTarget=AnyCPU on the
      command line as well so the referenced libraries follow (docs/app.md, "Publishing").
    -->
    <PlatformTarget Condition="'$(RuntimeIdentifier)' != ''">AnyCPU</PlatformTarget>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned 2.x like Slrr.Render / Slrr.Viewer (Silk.NET 3 breaks APIs). -->
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.22.0" />
    <!-- OpenAL Soft binaries (Windows has no system OpenAL; Linux may not have libopenal installed). -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Slrr.Race\Slrr.Race.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Scripts\*.input" LogicalName="Slrr.App.Scripts.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Slrr.App.Tests" />
  </ItemGroup>
</Project>
